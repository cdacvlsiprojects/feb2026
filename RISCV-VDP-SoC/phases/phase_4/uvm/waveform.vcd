$var wire 1 y* hcount [5] $end
$var wire 1 z* hcount [4] $end
$var wire 1 {* hcount [3] $end
$var wire 1 |* hcount [2] $end
$var wire 1 }* hcount [1] $end
$var wire 1 ~* hcount [0] $end
$var wire 1 !+ vcount [11] $end
$var wire 1 "+ vcount [10] $end
$var wire 1 #+ vcount [9] $end
$var wire 1 $+ vcount [8] $end
$var wire 1 %+ vcount [7] $end
$var wire 1 &+ vcount [6] $end
$var wire 1 '+ vcount [5] $end
$var wire 1 (+ vcount [4] $end
$var wire 1 )+ vcount [3] $end
$var wire 1 *+ vcount [2] $end
$var wire 1 ++ vcount [1] $end
$var wire 1 ,+ vcount [0] $end
$var wire 1 -+ hsync $end
$var wire 1 .+ vsync $end
$var wire 1 /+ video_active $end
$var wire 1 0+ frame_tick $end
$var reg 12 3, h_cnt [11:0] $end
$var reg 12 4, v_cnt [11:0] $end
$var wire 1 5, h_end $end
$var wire 1 6, v_end $end
$upscope $end
$upscope $end
$upscope $end
$upscope $end
$enddefinitions $end
